---
/**
 * Hero.astro — fully static, zero-hydration hero section.
 *
 * Why not React?
 * The original Hero.tsx used framer-motion with `animate` (not `whileInView`).
 * During SSR the text renders at full opacity. Then React hydrates, framer-motion
 * applies `initial: { opacity: 0, y: 20 }` and immediately animates back in.
 * The user sees: text visible → invisible → fade in. That IS the "jump".
 *
 * CSS animations avoid this completely:
 * - The stylesheet is applied BEFORE the first paint
 * - `animation-fill-mode: both` keeps elements at the `from` state before
 *   the animation starts (opacity: 0), so the text is invisible from frame 1
 * - No JS, no hydration, no mismatch
 *
 * Background image:
 * - No JS parallax — the parallax rAF loop runs after the first paint and
 *   causes the "loads higher then comes down" jump
 * - Static image with object-cover looks identical at rest
 * - Subtle CSS-only Ken Burns (slow zoom) adds life without CLS
 */

import consultingBg from "../../assets/compressed/consulting-bg.webp";
---

<section
  id="hero"
  class="relative min-h-screen flex items-center overflow-hidden"
>
  <!-- ── Background image ─────────────────────────────────────── -->
  <!-- No transform / parallax JS — just a static full-bleed image.
       The container clips overflow so the Ken Burns zoom doesn't spill. -->
  <div class="absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
    <img
      src={consultingBg.src}
      alt=""
      width={consultingBg.width}
      height={consultingBg.height}
      class="hero-bg-img absolute inset-0 w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <!-- ── Gradient overlay ─────────────────────────────────────── -->
  <div
    class="absolute inset-0 z-0"
    style="background: linear-gradient(to right, rgba(13,27,42,0.90) 0%, rgba(13,27,42,0.75) 50%, rgba(13,27,42,0.35) 100%);"
    aria-hidden="true"
  ></div>

  <!-- ── Content ──────────────────────────────────────────────── -->
  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-6 lg:px-8 w-full py-28 sm:py-32 md:py-40">
    <div class="max-w-2xl">

      <!-- Overline -->
      <p class="hero-line hero-d0 text-sm font-medium uppercase text-[#8B8B8B] mb-6"
         style="letter-spacing: 0.2em;">
        Consultoría Integral
      </p>

      <!-- Heading -->
      <h1 class="hero-line hero-d1 text-4xl sm:text-5xl md:text-6xl font-extrabold tracking-tight leading-[1.05] text-white mb-6"
          style="text-wrap: balance;">
        Acompañamos organizaciones en sus procesos de crecimiento, orden y transformación
      </h1>

      <!-- Subtext -->
      <p class="hero-line hero-d2 text-lg md:text-xl text-[#C4C8CE] mb-10 max-w-xl"
         style="text-wrap: pretty;">
        Ayudamos a empresas a escalar operaciones, mitigar riesgos y consolidar su liderazgo.
      </p>

    </div>
  </div>
</section>

<style>
  /* ── Text entrance animations ─────────────────────────────────
   * animation-fill-mode: both → element is locked at the `from` state
   * from frame 0 (before the delay), so text is invisible on first paint.
   * This is the key difference from framer-motion which makes the element
   * visible during SSR and only hides it after hydration → flash.
   * ─────────────────────────────────────────────────────────── */
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  .hero-line {
    animation: hero-fade-up 0.6s cubic-bezier(0.2, 0, 0, 1) both;
  }

  .hero-d0 { animation-delay:   0ms; }
  .hero-d1 { animation-delay: 100ms; }
  .hero-d2 { animation-delay: 200ms; }

  /* Respect reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .hero-line { animation: none; opacity: 1; transform: none; }
  }

  /* ── Background image subtle slow-zoom (Ken Burns) ────────────
   * Purely CSS, no JS, no layout shift.
   * Starts at scale(1.08) → scale(1) over 12s.
   * The `overflow: hidden` on the parent clips any overflow.
   * ─────────────────────────────────────────────────────────── */
  @keyframes hero-zoom {
    from { transform: scale(1.08); }
    to   { transform: scale(1);    }
  }

  .hero-bg-img {
    animation: hero-zoom 12s cubic-bezier(0.2, 0, 0, 1) both;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-bg-img { animation: none; }
  }
</style>
